<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create post</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
  <%- include("./partials/header.ejs") %>
    <section id="create-post">
    <h2>Create post</h2><br />
    <form action="/submit" method="POST" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name = "title" type="text" class="form-control" id="post-title" placeholder="Weather today...">
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="description" class="form-control" id="post-description" rows="3"></textarea>
          </div>
        <label for="image" class="form-label" >Image Upload</label><br />
        <input name="image" type="file" class="form-label" id="image" name="image"><br />
        <div class="centred-button">
        <button type="submit" class="btn btn-dark">Post</button>
     </div>
      </form>
    </section>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script>

</body>
</html>
